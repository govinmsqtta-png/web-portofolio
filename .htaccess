# ============================================================
# .htaccess - Portfolio Govindha Muskitta
# ============================================================

# Aktifkan MIME types yang benar untuk semua format gambar
AddType image/jpeg .jpg .jpeg
AddType image/png .png
AddType image/webp .webp
AddType image/svg+xml .svg
AddType text/css .css
AddType application/javascript .js

# Izinkan akses ke semua file di folder assets
<Directory "assets">
  Options -Indexes
  AllowOverride None
  Require all granted
</Directory>

# Cache gambar selama 30 hari
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# Kompres file teks untuk loading lebih cepat
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Set default halaman
DirectoryIndex index.html
